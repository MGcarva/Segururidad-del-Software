{
  "name": "atlas",
  "version": "1.0.0",
  "description": "API Atlas - Express + PostgreSQL (intencionalmente vulnerable)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon",
    "test": "jest",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "test:api": "node --test --test-reporter=spec tests/api/atlas-api.test.mjs",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:integration:ci": "jest --config jest.integration.config.js --runInBand --ci --reporters=default --reporters=jest-junit --json --outputFile=supertest-results.json"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.2"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/integration/",
      "/tests/api/"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.js",
      "src/middleware/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ]
  }
}
