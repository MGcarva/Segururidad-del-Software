        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="[DOCS] DELETE /contratos/:id (limpieza)" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
